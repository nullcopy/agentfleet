#compdef agentctl
# zsh completion for agentctl (agentfleet)

_agentctl_names() {
    local -a names
    names=(${(f)"$(agentctl names 2>/dev/null)"})
    _describe -t agents 'agent' names
}

_agentctl_removed() {
    local -a names
    names=(${(f)"$(agentctl names --removed 2>/dev/null)"})
    _describe -t agents 'removed agent' names
}

_agentctl() {
    local curcontext=$curcontext state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            local -a cmds
            cmds=(
                'list:show all agents, their state and Matrix id'
                'add:create an agent and start it'
                'edit:change model, description, limits, environment or Hermes settings; no flags opens $EDITOR'
                'rm:stop and remove an agent; files and account kept unless --purge'
                'purge:delete what rm left behind and retire the name for good'
                'start:start an agent, or all with --all'
                'stop:stop an agent, or all with --all'
                'restart:restart an agent, or all with --all'
                'status:Matrix connection, config check, profile lock and service status; or the table for all'
                'reset-config:reseed config.yaml from the definition and move stray profiles aside'
                'logs:show an agent'\''s journal'
                'matrix:the fleet'\''s Matrix server and the agents'\'' accounts'
                'secrets:an agent'\''s provider keys: set, edit, list'
            )
            _describe -t commands 'agentctl command' cmds
            ;;
        args)
            case $line[1] in
                add)
                    _arguments \
                        '1:name:' \
                        '--model[Hermes model id]:model:' \
                        '--description[free text]:description:' \
                        '--memory-max[systemd MemoryMax]:size:' \
                        '--cpu-quota[systemd CPUQuota]:percent:' \
                        '*--env[non-secret environment variable]:K=V:' \
                        '*--set[Hermes config.yaml key]:KEY=VAL:' \
                        '*--set-str[config key, value kept as string]:KEY=VAL:' \
                        '*--secret[key to store; prompted without =VALUE]:KEY[=VALUE]:' \
                        '--no-prompt[never prompt for secrets]' \
                        '--no-start[create but do not start]'
                    ;;
                edit)
                    _arguments \
                        '1:agent:_agentctl_names' \
                        '--model[Hermes model id]:model:' \
                        '--description[free text]:description:' \
                        '--memory-max[systemd MemoryMax; empty removes]:size:' \
                        '--cpu-quota[systemd CPUQuota; empty removes]:percent:' \
                        '*--env[set a non-secret environment variable]:K=V:' \
                        '*--unset-env[remove an environment variable]:K:' \
                        '*--set[Hermes config.yaml key]:KEY=VAL:' \
                        '*--set-str[config key, value kept as string]:KEY=VAL:' \
                        '*--unset[remove a config.yaml key]:KEY:' \
                        '--no-restart[do not restart a running agent]'
                    ;;
                rm)
                    _arguments '1:agent:_agentctl_names' '--purge[delete everything and retire the name]' '(-y --yes)'{-y,--yes}'[skip confirmation]'
                    ;;
                reset-config)
                    _arguments '1:agent:_agentctl_names' '(-y --yes)'{-y,--yes}'[skip confirmation]'
                    ;;
                purge)
                    _arguments '1:removed agent:_agentctl_removed' '(-y --yes)'{-y,--yes}'[skip confirmation]'
                    ;;
                start|stop|restart)
                    _arguments '1:agent:_agentctl_names' '--all[every enabled agent]'
                    ;;
                status)
                    _arguments '1:agent:_agentctl_names'
                    ;;
                logs)
                    _arguments '1:agent:_agentctl_names' '(-f --follow)'{-f,--follow}'[follow]' '(-n --lines)'{-n,--lines}'[number of lines]:lines:'
                    ;;
                secrets)
                    _arguments -C '1:action:(set edit list)' '2:agent:_agentctl_names' '*:KEY[=VALUE]:'
                    ;;
                matrix)
                    local -a subs
                    subs=(
                        'status:homeserver, admin account, every agent account'
                        'check:can the internet reach this server (DNS, TLS, proxy, federation)'
                        'introduce:(re)send the introduction DM'
                        'rotate-token:log the agent out everywhere, new token'
                        'start:start Synapse, the reconciler and every enabled agent'
                        'stop:stop Synapse and with it every agent'
                        'restart:restart Synapse and with it every agent'
                        'logs:journal of Synapse and the reconciler'
                    )
                    _arguments -C '1:subcommand:->msub' '*::marg:->margs'
                    case $state in
                        msub) _describe -t subcommands 'matrix subcommand' subs ;;
                        margs)
                            case $line[1] in
                                introduce|rotate-token) _arguments '1:agent:_agentctl_names' ;;
                                logs) _arguments '(-f --follow)'{-f,--follow}'[follow]' '(-n --lines)'{-n,--lines}'[lines]:lines:' ;;
                            esac
                            ;;
                    esac
                    ;;
            esac
            ;;
    esac
}

_agentctl "$@"
